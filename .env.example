PORT=3000
NODE_ENV=development
API_TOKEN=clipper-private-secret-key-2026

# Scratch disk directory for temporary segments and transcode outputs
SCRATCH_DIR=./scratch

# Job Constraints (Tuned for 2 vCPU / 4 GB VPS or local desktop)
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_DEPTH=3
MAX_CLIP_DURATION_SEC=300
MIN_FREE_DISK_MB=1500

# Optional path overrides (defaults to bundled ffmpeg-static and system/pip yt-dlp)
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# YTDLP_PATH=C:\\Python314\\Scripts\\yt-dlp.exe
